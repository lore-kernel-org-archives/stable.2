+	HARDWARE_ERROR		= 0x04,
+	ILLEGAL_REQUEST		= 0x05,
+	UNIT_ATTENTION		= 0x06,
+	DATA_PROTECT		= 0x07,
+	BLANK_CHECK		= 0x08,
+	VENDOR_SPECIFIC		= 0x09,
+	COPY_ABORTED		= 0x0a,
+	ABORTED_COMMAND		= 0x0b,
+	VOLUME_OVERFLOW		= 0x0d,
+	MISCOMPARE		= 0x0e,
+	COMPLETED		= 0x0f,
+};
+
+#define SCSI_ASC_DEF(name)	ASC_##name
+#define SCSI_ASC(name, code)				\
+	SCSI_ASC_DEF(name)	= (code),		\
+	name			= ((code) << 8) | 0x00
+
+/*
+ * SCSI additional sense codes and sense codes qualifiers.
+ * See: https://www.t10.org/lists/asc-num.txt
+ * Additional sense codes and their qualifiers are combined as a single value
+ * equal to (ASC << 8) | ASCQ.
+ *
+ * The definitions are sorted in increasing sense code value order with a naming
+ * following as close as possible the exact naming used in T10. To avoid
+ * excessively long code lines when using these macros, some long ASC/ASCQ
+ * combination names are shortened (E.g. LOGICAL_UNIT_xxx -> LU_xxx).
+ * Very generic ASC names that potentially may clash with other macros elsewhere
+ * are prefixed with "SSC_" (e.g. WARNING and WRITE_ERROR).
+ */
