-	else if (le16_to_cpu(rp->lmp_subver) <= 0x1899 &&
-		 rp->hci_ver > BLUETOOTH_VER_2_1)
-		is_fake = true;
-
-	else if (le16_to_cpu(rp->lmp_subver) <= 0x22bb &&
-		 rp->hci_ver > BLUETOOTH_VER_4_0)
