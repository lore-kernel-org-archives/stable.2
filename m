-	/* It's MediaTek specific bluetooth reset mechanism via USB */
-	if (test_and_set_bit(BTMTK_HW_RESET_ACTIVE, &btmtk_data->flags)) {
-		bt_dev_err(hdev, "last reset failed? Not resetting again");
