-	spin_lock_irqsave(&data->rxlock, flags);
-	skb = data->sco_skb;
-
-	while (count) {
-		int len;
-
-		if (!skb) {
-			skb = bt_skb_alloc(HCI_MAX_SCO_SIZE, GFP_ATOMIC);
-			if (!skb) {
-				err = -ENOMEM;
-				break;
-			}
