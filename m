-	 * not wait until HCI layer is ready.
-	 */
-	err = usb_control_msg_recv(udev, 0, request, USB_TYPE_VENDOR | USB_DIR_IN,
-				   0, 0, data, size, USB_CTRL_GET_TIMEOUT,
-				   GFP_KERNEL);
-	if (err)
