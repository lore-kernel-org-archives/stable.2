-}
-
-static int setup_rx(struct sockaddr *addr, socklen_t alen)
-{
-	struct timeval tv = { .tv_usec = 100 * 1000 };
-	int fd;
-
-	fd = socket(addr->sa_family, SOCK_DGRAM, 0);
-	if (fd == -1)
-		error(1, errno, "socket r");
-
-	if (bind(fd, addr, alen))
